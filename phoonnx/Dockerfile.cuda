ARG TAG=alpha
FROM smartgic/ovos-tts-server-base-cuda:${TAG}

ARG BUILD_DATE=unknown
ARG VERSION=unknown

LABEL org.opencontainers.image.title="Open Voice OS OCI TTS Phoonnx image with Nvidia CUDA support"
LABEL org.opencontainers.image.description="A TTS plugin for Open Voice OS using Phoonnx and ONNX Runtime CUDA"
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.documentation="https://openvoiceos.github.io/community-docs"
LABEL org.opencontainers.image.source="https://github.com/OpenVoiceOS/ovos-docker-tts"
LABEL org.opencontainers.image.vendor="Open Voice OS"

ARG ALPHA=false
ARG USER=ovos
ARG PHOONNX_REF=1.3.3

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HOME=/home/${USER}/.cache/huggingface
ENV XDG_CACHE_HOME=/home/${USER}/.cache
ENV CUDA=1

SHELL ["/bin/bash", "-c"]

USER root

COPY phoonnx/patches/phoonnx-cuda-config.patch /tmp/phoonnx-cuda-config.patch

RUN mkdir -p /var/lib/apt/lists/partial \
    && apt-get update \
    && apt-get install -y --no-install-recommends espeak-ng libsndfile1 patch \
    && mkdir -p /home/${USER}/.cache/huggingface /home/${USER}/.cache/phoonnx /home/${USER}/gradio_cached_examples \
    && chown ${USER}:${USER} -R /home/${USER} \
    && apt-get --purge autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt /var/log/{apt,dpkg.log}

USER $USER

RUN pip3 install --no-cache-dir --upgrade pip wheel \
    && if [ "${ALPHA}" == "true" ]; then \
        pip3 install --no-cache-dir --pre "gradio-client<1.0" "setuptools<81" ovos-tts-server ovos-classifiers \
            "phoonnx @ git+https://github.com/TigreGotico/phoonnx.git@dev"; \
    else \
        pip3 install --no-cache-dir "gradio-client<1.0" "setuptools<81" ovos-tts-server ovos-classifiers \
            "phoonnx @ git+https://github.com/TigreGotico/phoonnx.git@${PHOONNX_REF}"; \
    fi \
    && pip3 uninstall -y onnxruntime \
    && pip3 install --no-cache-dir coloredlogs flatbuffers numpy packaging protobuf sympy \
    && pip3 install --no-cache-dir onnxruntime-gpu \
        --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-11/pypi/simple/ \
    && patch -d "${VIRTUAL_ENV}/lib/python3.10/site-packages/phoonnx" -p0 < /tmp/phoonnx-cuda-config.patch \
    && mkdir -p /home/${USER}/.cache/phoonnx /home/${USER}/gradio_cached_examples \
    && rm -rf /home/${USER}/.cache/pip

ENTRYPOINT ["/home/ovos/.venv/bin/ovos-tts-server", "--engine", "ovos-tts-plugin-phoonnx", "--cache"]

EXPOSE 9666
