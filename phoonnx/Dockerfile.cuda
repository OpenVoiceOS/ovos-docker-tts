FROM nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04

ARG BUILD_DATE=unknown
ARG VERSION=unknown

LABEL org.opencontainers.image.title="Open Voice OS OCI TTS Phoonnx image with Nvidia CUDA support"
LABEL org.opencontainers.image.description="A TTS plugin for Open Voice OS using Phoonnx and ONNX Runtime CUDA"
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.documentation="https://openvoiceos.github.io/community-docs"
LABEL org.opencontainers.image.source="https://github.com/OpenVoiceOS/ovos-docker-tts"
LABEL org.opencontainers.image.vendor="Open Voice OS"

ARG ALPHA=false
ARG USER=ovos
ARG PHOONNX_REPOSITORY=https://github.com/TigreGotico/phoonnx.git
ARG PHOONNX_REF=a05d94eb014f5f62d5375b582db18f21fcc5fc4c
ARG PHOONNX_ALPHA_REF=dev
ARG ONNXRUNTIME_GPU_REF=1.26.0
ARG OVOS_TTS_SERVER_REF=1.13.4
ARG OVOS_CLASSIFIERS_REF=0.0.0a59
ARG ESPEAK_NG_REF=1.52.0
ARG ESPEAK_NG_COMMIT=4870adfa25b1a32b4361592f1be8a40337c58d6c

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/home/${USER}/.venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV VIRTUAL_ENV=/home/${USER}/.venv
ENV HF_HOME=/home/${USER}/.cache/huggingface
ENV XDG_CACHE_HOME=/home/${USER}/.cache
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

SHELL ["/bin/bash", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libsndfile1 \
        python3 \
        python3-pip \
        python3-venv \
    && if getent passwd 1000 >/dev/null; then userdel -r "$(getent passwd 1000 | cut -d: -f1)"; fi \
    && if getent group 1000 >/dev/null; then groupdel "$(getent group 1000 | cut -d: -f1)"; fi \
    && groupadd --gid 1000 ${USER} \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ${USER} \
    && python3 -m venv /home/${USER}/.venv \
    && mkdir -p \
        /home/${USER}/.cache/huggingface \
        /home/${USER}/.cache/phoonnx \
        /home/${USER}/.config/mycroft \
        /home/${USER}/gradio_cached_examples \
    && chown -R ${USER}:${USER} /home/${USER} \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# eSpeak NG is built from source. Ubuntu 24.04 packages 1.51, which reads Mandarin as English
# letter names, and the Chinese Piper voices then speak nonsense. The commit is checked because a
# tag can be moved. The audio back ends are left out: the server asks eSpeak for phonemes only.
# The build tools leave in the same layer. The last lines fail the build if Mandarin falls back
# to English again.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        libtool \
        pkg-config \
    && git clone --depth 1 --branch "${ESPEAK_NG_REF}" https://github.com/espeak-ng/espeak-ng.git /tmp/espeak-ng \
    && cd /tmp/espeak-ng \
    && test "$(git rev-parse HEAD)" = "${ESPEAK_NG_COMMIT}" \
    && ./autogen.sh \
    && ./configure --prefix=/usr/local \
        --with-extdict-cmn --with-extdict-ru --with-extdict-yue \
        --without-async --without-mbrola --without-pcaudio --without-sonic --without-speechplayer \
    && make \
    && make install \
    && rm -f /usr/local/lib/libespeak-ng.a /usr/local/lib/libespeak-ng.la \
    && ldconfig \
    && cd / \
    && rm -rf /tmp/espeak-ng \
    && apt-get purge -y --auto-remove autoconf automake build-essential libtool pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && mandarin="$(echo '這是語音助理' | espeak-ng -q -x --ipa -v cmn)" \
    && test -n "${mandarin}" \
    && ! grep -q '(en)' <<< "${mandarin}"

USER ${USER}

# scriptconv[...] installs the phonemizers that phoonnx leaves out. A voice that needs one of
# them fails without it, or reads Arabic and Hebrew without their vowels:
#   espeak    the eSpeak wrapper, which the espeak extra of phoonnx 1.64 no longer installs
#   he        the Hebrew voices
#   misaki    the English, Japanese and Chinese voices of Kokoro
#   pt        the Portuguese voices of Kokoro, on phoonnx 1.64
#   tashkeel  the vowel marks of Arabic text
# The floor is the one the dev branch of phoonnx asks for. It names a pre-release, and pip takes
# scriptconv's alpha line for this requirement only when the requirement itself names one.
# misaki's English extra also asks for a spaCy transformer tagger and, through it, for PyTorch.
# scriptconv does not use the tagger, but spaCy imports both when they are installed (190 MB of
# memory, 0.9 GB of image). PyTorch's CPU wheel goes in first, so that the resolver does not
# take the CUDA wheel with its own CUDA libraries, and both are removed again. The spaCy model
# is installed here because misaki would otherwise fetch it with pip on the first request. The
# G2P call fails the build if English does not load without the removed packages.
RUN python -m pip install --no-cache-dir --upgrade pip wheel \
    && python -m pip install --no-cache-dir \
        "ovos-tts-server==${OVOS_TTS_SERVER_REF}" \
        "ovos-classifiers==${OVOS_CLASSIFIERS_REF}" \
    && if [ "${ALPHA}" = "true" ]; then \
        phoonnx_ref="${PHOONNX_ALPHA_REF}"; \
    else \
        phoonnx_ref="${PHOONNX_REF}"; \
    fi \
    && python -m pip install --no-cache-dir --no-deps \
        --index-url https://download.pytorch.org/whl/cpu torch \
    && python -m pip install --no-cache-dir \
        "phoonnx[espeak] @ git+${PHOONNX_REPOSITORY}@${phoonnx_ref}" \
        "scriptconv[espeak,he,misaki,pt,tashkeel]>=0.0.4a123" \
    && python -m pip uninstall -y \
        spacy-curated-transformers curated-transformers curated-tokenizers \
        torch sympy mpmath networkx \
    && python -m spacy download en_core_web_sm \
    && python -c "from misaki import en; en.G2P()('The image can speak English.')" \
    && python -m pip uninstall -y onnxruntime \
    && python -m pip install --no-cache-dir --no-deps \
        "onnxruntime-gpu==${ONNXRUNTIME_GPU_REF}" \
    && python -c \
        "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers(), ort.get_available_providers()" \
    && rm -rf /home/${USER}/.cache/pip

# The streaming route (phoonnx/stream), in a layer of its own: a change to it does not
# rebuild the layer above.
COPY --chown=${USER}:${USER} phoonnx/stream /tmp/stream

RUN python -m pip install --no-cache-dir /tmp/stream \
    && rm -rf /home/${USER}/.cache/pip

WORKDIR /home/${USER}

# ovos-tts-server plus GET /v2/synthesize/stream (phoonnx/stream)
ENTRYPOINT ["/home/ovos/.venv/bin/ovos-tts-server-stream", "--engine", "ovos-tts-plugin-phoonnx", "--cache"]

EXPOSE 9666
