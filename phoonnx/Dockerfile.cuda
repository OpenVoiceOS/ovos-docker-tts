FROM nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04

ARG BUILD_DATE=unknown
ARG VERSION=unknown

LABEL org.opencontainers.image.title="Open Voice OS OCI TTS Phoonnx image with Nvidia CUDA support"
LABEL org.opencontainers.image.description="A TTS plugin for Open Voice OS using Phoonnx and ONNX Runtime CUDA"
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.documentation="https://openvoiceos.github.io/community-docs"
LABEL org.opencontainers.image.source="https://github.com/OpenVoiceOS/ovos-docker-tts"
LABEL org.opencontainers.image.vendor="Open Voice OS"

ARG ALPHA=false
ARG USER=ovos
ARG PHOONNX_REPOSITORY=https://github.com/TigreGotico/phoonnx.git
ARG PHOONNX_REF=1.64.1a1
ARG PHOONNX_ALPHA_REF=dev
ARG ONNXRUNTIME_GPU_REF=1.26.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/home/${USER}/.venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV VIRTUAL_ENV=/home/${USER}/.venv
ENV HF_HOME=/home/${USER}/.cache/huggingface
ENV XDG_CACHE_HOME=/home/${USER}/.cache
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

SHELL ["/bin/bash", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        espeak-ng \
        git \
        libsndfile1 \
        python3 \
        python3-pip \
        python3-venv \
    && if getent passwd 1000 >/dev/null; then userdel -r "$(getent passwd 1000 | cut -d: -f1)"; fi \
    && if getent group 1000 >/dev/null; then groupdel "$(getent group 1000 | cut -d: -f1)"; fi \
    && groupadd --gid 1000 ${USER} \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ${USER} \
    && python3 -m venv /home/${USER}/.venv \
    && mkdir -p \
        /home/${USER}/.cache/huggingface \
        /home/${USER}/.cache/phoonnx \
        /home/${USER}/.config/mycroft \
        /home/${USER}/gradio_cached_examples \
    && chown -R ${USER}:${USER} /home/${USER} \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER ${USER}

RUN python -m pip install --no-cache-dir --upgrade pip wheel \
    && python -m pip install --no-cache-dir ovos-tts-server ovos-classifiers \
    && if [ "${ALPHA}" = "true" ]; then \
        phoonnx_ref="${PHOONNX_ALPHA_REF}"; \
    else \
        phoonnx_ref="${PHOONNX_REF}"; \
    fi \
    && python -m pip install --no-cache-dir \
        "phoonnx @ git+${PHOONNX_REPOSITORY}@${phoonnx_ref}" \
    && python -m pip uninstall -y onnxruntime \
    && python -m pip install --no-cache-dir --no-deps \
        "onnxruntime-gpu==${ONNXRUNTIME_GPU_REF}" \
    && python -c \
        "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers(), ort.get_available_providers()" \
    && rm -rf /home/${USER}/.cache/pip

WORKDIR /home/${USER}

ENTRYPOINT ["/home/ovos/.venv/bin/ovos-tts-server", "--engine", "ovos-tts-plugin-phoonnx", "--cache"]

EXPOSE 9666
